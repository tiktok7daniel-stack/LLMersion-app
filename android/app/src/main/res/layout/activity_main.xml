<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fitsSystemWindows="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="12dp" android:paddingBottom="112dp">

            <!-- brand row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/logo" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:paddingStart="10dp" android:textDirection="ltr"
                    android:textAlignment="viewStart" style="@style/Text.Title" />
                <ImageButton android:id="@+id/tutorBtn" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_badge" android:src="@drawable/ic_chat"
                    android:contentDescription="@string/tutor" android:layout_marginEnd="8dp" />
                <ImageButton android:id="@+id/aboutBtn" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_badge" android:src="@drawable/ic_info"
                    android:contentDescription="@string/about" />
            </LinearLayout>

            <!-- headline -->
            <TextView android:id="@+id/headline" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" style="@style/Text.Display" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/subtitle" style="@style/Text.Body" />

            <!-- continue reading -->
            <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:background="@drawable/bg_hero" android:orientation="vertical"
                android:padding="22dp" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/heroLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/continue_reading" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/on_hero" android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
                    android:textDirection="firstStrong" android:textAlignment="viewStart" />
                <ProgressBar android:id="@+id/heroProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="16dp"
                    android:progressDrawable="@drawable/bg_progress_track" android:max="100" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
                    <TextView android:id="@+id/heroMeta" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_play">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_play" app:tint="#FFFFFF" android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- quick actions -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp">
                <LinearLayout android:id="@+id/openBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical" style="@style/Glass"
                    android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_badge">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                            android:src="@drawable/ic_page" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:text="@string/open_file" style="@style/Text.Title"
                        android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/open_file_sub" style="@style/Text.Caption" />
                </LinearLayout>
                <LinearLayout android:id="@+id/pasteBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical" style="@style/Glass"
                    android:layout_marginStart="8dp" android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_badge">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                            android:src="@drawable/ic_add" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:text="@string/paste_text" style="@style/Text.Title"
                        android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/paste_text_sub" style="@style/Text.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- stats -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp" style="@style/Glass">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/statWords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        style="@style/Text.Title" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stat_words" style="@style/Text.Caption" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/statLearned" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        style="@style/Text.Title" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stat_learned" style="@style/Text.Caption" />
                </LinearLayout>
                <LinearLayout android:id="@+id/statDueBox" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"
                    android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/statDue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        style="@style/Text.Title" android:textSize="24sp" android:textColor="@color/accent" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stat_due" style="@style/Text.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- recent -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:layout_marginBottom="10dp"
                android:text="@string/recent" style="@style/Text.Section" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/docs"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/no_docs"
                android:gravity="center" android:padding="24dp" android:visibility="gone"
                style="@style/Text.Body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_navbar" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@android:color/transparent" />
    <ProgressBar android:id="@+id/rail" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:progressDrawable="@drawable/bg_progress_track" />
    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_margin="20dp" android:background="@drawable/bg_glass"
        android:clickable="true" android:focusable="true"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:id="@+id/word" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="44sp"
            android:fontFamily="sans-serif-black" android:textColor="@color/text" android:textDirection="ltr" />
        <TextView android:id="@+id/ipa" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="18sp"
            android:textColor="@color/text2" android:layout_marginTop="8dp" android:textDirection="ltr" />
        <TextView android:id="@+id/gloss" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="26sp" android:gravity="center"
            android:lineSpacingMultiplier="1.3" android:textColor="@color/accent" android:layout_marginTop="28dp" />
        <TextView android:id="@+id/ctx" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:gravity="center"
            android:textColor="@color/text2" android:layout_marginTop="18dp"
            android:fontFamily="serif" android:textDirection="ltr" />
        <TextView android:id="@+id/hint" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/tap_to_flip"
            android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            style="@style/Text.Caption" android:layout_marginTop="32dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/grades" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/g0" style="@style/Button.Glass"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/again" android:textColor="@color/poor" android:layout_marginEnd="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/g1" style="@style/Button.Glass"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/hard" android:textColor="@color/mid" android:layout_marginEnd="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/g2" style="@style/Button.Glass"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/good" android:textColor="@color/good" android:layout_marginEnd="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/g3" style="@style/Button.Gradient"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/easy" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="64dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:layout_marginBottom="20dp"
        android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_glass_pill"
        android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageButton android:id="@+id/prev" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" android:contentDescription="@string/prev_sentence" />
        <FrameLayout android:id="@+id/say" android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:background="@drawable/bg_play"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/listen">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_volume" app:tint="#FFFFFF" android:importantForAccessibility="no" />
        </FrameLayout>
        <ImageButton android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:rotationY="180"
            android:src="@drawable/ic_back" android:contentDescription="@string/next_sentence" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="20dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <ImageView android:layout_width="24dp" android:layout_height="24dp"
        android:src="@drawable/ic_book" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/text"
            android:textSize="16sp" android:maxLines="2" android:ellipsize="end"
            android:textDirection="firstStrong" android:textAlignment="viewStart" />
        <TextView android:id="@+id/meta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text3" android:textSize="13sp" />
    </LinearLayout>
    <ImageView android:layout_width="20dp" android:layout_height="20dp"
        android:src="@drawable/ic_chevron" android:importantForAccessibility="no" />
</LinearLayout>

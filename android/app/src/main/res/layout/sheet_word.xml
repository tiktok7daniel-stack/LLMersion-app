<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
        <TextView android:id="@+id/word" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/text" android:fontFamily="serif" android:textDirection="ltr" />
        <TextView android:id="@+id/ipa" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/text2" android:paddingStart="12dp" android:textDirection="ltr" />
        <ImageButton android:id="@+id/listen" style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_volume" android:contentDescription="@string/listen" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/meaning" android:textColor="@color/text3" android:textSize="12sp"
        android:layout_marginTop="12dp" />
    <TextView android:id="@+id/gloss" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@color/text" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/definition" android:textColor="@color/text3" android:textSize="12sp"
        android:layout_marginTop="12dp" />
    <TextView android:id="@+id/def" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text2"
        android:textDirection="ltr" android:textAlignment="viewStart" />
    <TextView android:id="@+id/saved" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/saved_auto"
        android:textColor="@color/text3" android:textSize="12sp" android:layout_marginTop="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/readHere" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/read_from_here"
            app:icon="@drawable/ic_play" android:layout_marginEnd="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/remove_word" />
    </LinearLayout>
</LinearLayout>

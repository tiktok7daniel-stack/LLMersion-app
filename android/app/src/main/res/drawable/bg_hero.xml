<?xml version="1.0" encoding="utf-8"?>
<!-- the "continue reading" card: brand blue to indigo, with a warm gold glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#1D4ED8" android:endColor="#4F46E5" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="260dp" android:centerX="1.0" android:centerY="0.0"
                android:startColor="#66F59E0B" android:endColor="#00F59E0B" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
